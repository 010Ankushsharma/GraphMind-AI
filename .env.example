APP_NAME=Ecommerce Knowledge Graph AI
APP_ENV=development
LOG_LEVEL=INFO

LLM_PROVIDER=mock
LLM_FALLBACK_PROVIDER=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=120

GEMINI_API_KEY=
